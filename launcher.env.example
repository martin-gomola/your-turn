# Copy to ~/.your-turn/launcher.env (or the selected --state-dir), then restart Your Turn.
# Slots 1–4 keep Codex, Claude Code, Cursor and Your Turn Settings.
# Slots 5–16 accept installed macOS app names. Omitted or empty values leave placeholders.
YOUR_TURN_LAUNCHER_5=Ghostty
# YOUR_TURN_LAUNCHER_9="Activity Monitor"
# No shell commands, arguments, paths, URLs or variable expansion.
